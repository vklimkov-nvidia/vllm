name: "codec_decoder"
backend: "python"
max_batch_size: 32

input [
  {
    name: "audio_codes"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
  }
]

output [
  {
    name: "audio_values"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 30000
  preferred_batch_size: [ 32 ]
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

parameters {
  key: "codec_engine_path"
  value: { string_value: "/workspace/server/models/codec_fp16.trt" }
}
